                <grid id="584">
                    <property name="width">10.1in</property>
                    <column id="585"><property name="width">8.6in</property></column>
                    <column id="586"><property name="width">1.5in</property></column>
                    <row id="587">
                        <cell id="588"><property name="borderTopColor">#e0e0e0</property><property name="borderTopStyle">solid</property><property name="borderTopWidth">1px</property><property name="paddingTop">3pt</property><label id="589"><property name="fontSize">7pt</property><property name="color">#6f6f6f</property><text-property name="text">Maximo MAS Upgrade Readiness  ·  SQL Server, Oracle, Db2  ·  read-only  ·  Created by Mohamed Chihaoui</text-property></label></cell>
                        <cell id="590"><property name="borderTopColor">#e0e0e0</property><property name="borderTopStyle">solid</property><property name="borderTopWidth">1px</property><property name="paddingTop">3pt</property><property name="textAlign">right</property>
                            <grid id="591"><column id="592"/><column id="593"/><column id="594"/><column id="595"/>
                                <row id="596">
                                    <cell id="597"><label id="598"><property name="fontSize">7pt</property><property name="color">#6f6f6f</property><property name="textAlign">right</property><text-property name="text">Page</text-property></label></cell>
                                    <cell id="599"><auto-text id="600"><property name="fontSize">7pt</property><property name="color">#6f6f6f</property><property name="textAlign">center</property><property name="type">page-number</property></auto-text></cell>
