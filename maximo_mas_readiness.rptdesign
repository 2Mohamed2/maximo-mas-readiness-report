    <body>
        <grid id="101">
            <property name="width">10.1in</property>
            <column id="102"><property name="width">6.6in</property></column>
            <column id="103"><property name="width">3.5in</property></column>
            <row id="104">
                <cell id="105"><property name="paddingBottom">6pt</property>
                    <label id="106"><property name="fontSize">7.5pt</property><property name="color">#525252</property><property name="fontWeight">bold</property><property name="letterSpacing">0.32pt</property><text-property name="text">IBM MAXIMO  ·  MAS UPGRADE READINESS</text-property></label>
                    <label id="107"><property name="fontSize">20pt</property><property name="color">#161616</property><property name="marginTop">2pt</property><text-property name="text">What it takes to move this Maximo to MAS</text-property></label>
                    <label id="108"><property name="fontSize">9pt</property><property name="color">#525252</property><property name="marginTop">2pt</property><text-property name="text">Everything in this Maximo 7.6 system that has to be rebuilt, reworked, reconfigured or replaced in Maximo Application Suite (MAS) Manage, area by area. Read-only, on SQL Server, Oracle or Db2.</text-property></label>
                    <label id="109"><property name="fontSize">8pt</property><property name="color">#0043ce</property><property name="fontWeight">bold</property><property name="marginTop">4pt</property><text-property name="text">Created by Mohamed Chihaoui</text-property></label>
                </cell>
                <cell id="110"><property name="textAlign">right</property><property name="verticalAlign">bottom</property><property name="paddingBottom">6pt</property>
                    <data id="111"><property name="fontSize">7.5pt</property><property name="color">#525252</property><property name="textAlign">right</property><list-property name="boundDataColumns"><structure><property name="name">v</property><expression name="expression" type="javascript"><![CDATA["Run " + Formatter.format(new Date(), "yyyy-MM-dd HH:mm")]]></expression><property name="dataType">string</property></structure></list-property><property name="resultSetColumn">v</property></data>
                </cell>
            </row>
        </grid>
        <table id="112">
            <property name="marginTop">6pt</property>
            <property name="width">10.1in</property>
            <property name="dataSet">dsStatus</property>
            <list-property name="boundDataColumns">
                <structure><property name="name">maxupg</property>
                    <expression name="expression" type="javascript">dataSetRow["maxupg"]</expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">dbver</property>
                    <expression name="expression" type="javascript">dataSetRow["dbver"]</expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">dbname</property>
                    <expression name="expression" type="javascript">dataSetRow["dbname"]</expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">line</property>
                    <expression name="expression" type="javascript"><![CDATA["Maximo " + maxVersion(row["maxupg"]) + "  ·  database " + row["dbname"] + "  ·  " + engineName() + " " + row["dbver"]]]></expression>
                    <property name="dataType">string</property></structure>
            </list-property>
            <column id="113"><property name="width">10.1in</property></column>
            <detail><row id="114"><cell id="115"><property name="backgroundColor">#edf5ff</property><property name="borderLeftColor">#0043ce</property><property name="borderLeftStyle">solid</property><property name="borderLeftWidth">3px</property><property name="paddingTop">6pt</property><property name="paddingBottom">6pt</property><property name="paddingLeft">10pt</property><property name="paddingRight">10pt</property><data id="116"><property name="fontSize">8.5pt</property><property name="fontWeight">bold</property><property name="color">#161616</property><property name="resultSetColumn">line</property></data></cell></row></detail>
        </table>
        <table id="136">
            <property name="marginTop">10pt</property>
            <property name="width">10.10in</property>
            <property name="dataSet">dsKpi</property>
            <list-property name="boundDataColumns">
                <structure><property name="name">classes</property>
                    <expression name="expression" type="javascript">dataSetRow["classes"]</expression>
                    <property name="dataType">integer</property></structure>
                <structure><property name="name">scripts</property>
                    <expression name="expression" type="javascript">dataSetRow["scripts"]</expression>
                    <property name="dataType">integer</property></structure>
                <structure><property name="name">risky</property>
                    <expression name="expression" type="javascript">dataSetRow["risky"]</expression>
                    <property name="dataType">integer</property></structure>
                <structure><property name="name">deps</property>
                    <expression name="expression" type="javascript">dataSetRow["deps"]</expression>
                    <property name="dataType">integer</property></structure>
                <structure><property name="name">endpoints</property>
                    <expression name="expression" type="javascript">dataSetRow["endpoints"]</expression>
                    <property name="dataType">integer</property></structure>
                <structure><property name="name">dbobjs</property>
