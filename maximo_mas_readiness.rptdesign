                    <property name="dataType">integer</property></structure>
                <structure><property name="name">addons</property>
                    <expression name="expression" type="javascript">dataSetRow["addons"]</expression>
                    <property name="dataType">integer</property></structure>
                <structure><property name="name">users</property>
                    <expression name="expression" type="javascript">dataSetRow["users"]</expression>
                    <property name="dataType">integer</property></structure>
                <structure><property name="name">k1</property>
                    <expression name="expression" type="javascript"><![CDATA[Formatter.format(row["classes"], "#,##0")]]></expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">k1s</property>
                    <expression name="expression" type="javascript"><![CDATA[row["classes"] == 0 ? "no custom Java classes" : "custom Java classes to rebuild"]]></expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">k2</property>
                    <expression name="expression" type="javascript"><![CDATA[Formatter.format(row["risky"], "#,##0")]]></expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">k2s</property>
                    <expression name="expression" type="javascript"><![CDATA["of " + Formatter.format(row["scripts"], "#,##0") + " automation scripts depend on the server"]]></expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">k3</property>
                    <expression name="expression" type="javascript"><![CDATA[Formatter.format(row["deps"], "#,##0")]]></expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">k3s</property>
                    <expression name="expression" type="javascript"><![CDATA["folder paths and host names in settings"]]></expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">k4</property>
                    <expression name="expression" type="javascript"><![CDATA[Formatter.format(row["endpoints"], "#,##0")]]></expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">k4s</property>
                    <expression name="expression" type="javascript"><![CDATA["environment-bound integration endpoints"]]></expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">k5</property>
