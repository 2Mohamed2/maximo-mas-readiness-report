            <detail><row id="306"><property name="pageBreakInside">avoid</property><cell id="277"><property name="paddingTop">4pt</property><property name="paddingBottom">4pt</property><property name="paddingLeft">6pt</property><property name="paddingRight">6pt</property><property name="verticalAlign">top</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><data id="276"><property name="fontSize">8.5pt</property><property name="fontWeight">bold</property><property name="resultSetColumn">autoscript</property></data></cell><cell id="279"><property name="paddingTop">4pt</property><property name="paddingBottom">4pt</property><property name="paddingLeft">6pt</property><property name="paddingRight">6pt</property><property name="verticalAlign">top</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><data id="278"><property name="fontSize">8pt</property><property name="resultSetColumn">lang</property></data></cell><cell id="281"><property name="paddingTop">4pt</property><property name="paddingBottom">4pt</property><property name="paddingLeft">6pt</property><property name="paddingRight">6pt</property><property name="verticalAlign">top</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><data id="280"><property name="fontSize">8pt</property><property name="resultSetColumn">act</property></data></cell><cell id="283"><property name="paddingTop">4pt</property><property name="paddingBottom">4pt</property><property name="paddingLeft">6pt</property><property name="paddingRight">6pt</property><property name="verticalAlign">top</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><property name="textAlign">right</property><data id="282"><property name="fontSize">8.5pt</property><structure name="numberFormat"><property name="category">Custom</property><property name="pattern">#,##0</property></structure><property name="resultSetColumn">lps</property></data></cell><cell id="285"><property name="paddingTop">4pt</property><property name="paddingBottom">4pt</property><property name="paddingLeft">6pt</property><property name="paddingRight">6pt</property><property name="verticalAlign">top</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><property name="textAlign">right</property><data id="284"><property name="fontSize">8pt</property><property name="color">#525252</property><structure name="numberFormat"><property name="category">Custom</property><property name="pattern">#,##0</property></structure><property name="resultSetColumn">chars</property></data></cell><cell id="287"><property name="paddingTop">4pt</property><property name="paddingBottom">4pt</property><property name="paddingLeft">6pt</property><property name="paddingRight">6pt</property><property name="verticalAlign">top</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><data id="286"><property name="fontSize">8pt</property><property name="fontWeight">bold</property><property name="color">#9f1853</property><property name="resultSetColumn">deps</property></data></cell></row></detail>
        </table><data id="307"><list-property name="visibility"><structure><property name="format">all</property><expression name="valueExpr" type="javascript"><![CDATA[rows_dsScripts > 0]]></expression></structure></list-property><property name="fontSize">8.5pt</property><property name="color">#6f6f6f</property><property name="paddingTop">10pt</property><property name="paddingBottom">10pt</property><property name="paddingLeft">8pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><list-property name="boundDataColumns"><structure><property name="name">v</property><expression name="expression" type="javascript"><![CDATA[readyEmpty("dsScripts", "No automation script depends on the server it runs on.")]]></expression><property name="dataType">string</property></structure></list-property><property name="resultSetColumn">v</property></data><grid id="310"><property name="marginTop">8pt</property><property name="width">10.1in</property><column id="311"/><row id="312"><cell id="313"><property name="backgroundColor">#edf5ff</property><property name="borderLeftColor">#0043ce</property><property name="borderLeftStyle">solid</property><property name="borderLeftWidth">3px</property><property name="paddingTop">6pt</property><property name="paddingBottom">6pt</property><property name="paddingLeft">10pt</property><property name="paddingRight">10pt</property><label id="314"><property name="fontSize">8.5pt</property><property name="fontWeight">bold</property><property name="color">#161616</property><text-property name="text">What each dependency means in MAS</text-property></label><label id="315"><property name="fontSize">8pt</property><property name="color">#525252</property><property name="marginTop">2pt</property><text-property name="text">Files and Folder paths: the container file system is not kept between restarts; use a persistent volume or object storage. OS commands: no operating system shell to call. Direct SQL: works, but bypasses Maximo security and must match the database MAS uses. Outbound calls and Web addresses: the cluster needs network access to the target, and localhost or server names change. Server libraries: Jython libraries in a server folder must be packaged with the customization archive. JavaScript engine: retest on the Java version of the target Manage release.</text-property></label></cell></row></grid><grid id="319"><property name="pageBreakBefore">always</property><property name="pageBreakInside">avoid</property><property name="marginTop">18pt</property><property name="width">10.1in</property><column id="320"/><row id="321"><cell id="322"><label id="316"><property name="fontSize">7.5pt</property><property name="color">#0f62fe</property><property name="fontWeight">bold</property><property name="letterSpacing">0.32pt</property><text-property name="text">3  ·  PATHS</text-property></label><label id="317"><property name="fontSize">14pt</property><property name="color">#161616</property><property name="marginTop">2pt</property><property name="marginBottom">2pt</property><text-property name="text">Folder paths and host names in settings and endpoints</text-property></label><label id="318"><property name="fontSize">8.5pt</property><property name="color">#525252</property><property name="marginBottom">8pt</property><text-property name="text">System properties and endpoint properties whose value is a folder on a server (C:\..., \\share, /opt/...), a local host, or a web address. Folders become persistent volumes or object storage in MAS; localhost and server names become the MAS routes.</text-property></label></cell></row></grid>
        <table id="345">
            <property name="width">10.10in</property>
            <property name="dataSet">dsDeps</property>
            <list-property name="boundDataColumns">
                <structure><property name="name">kind</property>
                    <expression name="expression" type="javascript">dataSetRow["kind"]</expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">owner</property>
                    <expression name="expression" type="javascript">dataSetRow["owner"]</expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">item</property>
