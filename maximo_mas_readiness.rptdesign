        </table><data id="526"><list-property name="visibility"><structure><property name="format">all</property><expression name="valueExpr" type="javascript"><![CDATA[rows_dsTables > 0]]></expression></structure></list-property><property name="fontSize">8.5pt</property><property name="color">#6f6f6f</property><property name="paddingTop">10pt</property><property name="paddingBottom">10pt</property><property name="paddingLeft">8pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><list-property name="boundDataColumns"><structure><property name="name">v</property><expression name="expression" type="javascript"><![CDATA[readyEmpty("dsTables", "No tables found.")]]></expression><property name="dataType">string</property></structure></list-property><property name="resultSetColumn">v</property></data><grid id="531"><property name="pageBreakInside">avoid</property><property name="marginTop">18pt</property><property name="width">10.1in</property><column id="532"/><row id="533"><cell id="534"><label id="529"><property name="fontSize">7.5pt</property><property name="color">#0f62fe</property><property name="fontWeight">bold</property><property name="letterSpacing">0.32pt</property><text-property name="text">APPENDIX</text-property></label><label id="530"><property name="fontSize">14pt</property><property name="color">#161616</property><property name="marginTop">2pt</property><property name="marginBottom">2pt</property><text-property name="text">Method and limits</text-property></label></cell></row></grid><grid id="565"><property name="width">10.1in</property>
            <column id="566"><property name="width">1.9in</property></column><column id="567"><property name="width">8.2in</property></column><row id="535"><cell id="536"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="537"><property name="fontSize">8pt</property><property name="fontWeight">bold</property><property name="color">#161616</property><text-property name="text">What is read</text-property></label></cell>
                <cell id="538"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="539"><property name="fontSize">8pt</property><property name="color">#525252</property><text-property name="text">Maximo tables (MAXOBJECT, MAXATTRIBUTE, MAXSERVICE, CRONTASKDEF, ACTION, CONDITION, MAXHANDLER, MAXINTOBJECT, MAXIFACEIN, MAXIFACEOUT, AUTOSCRIPT, SCRIPTLAUNCHPOINT, MAXPROPVALUE, MAXENDPOINT, MAXENDPOINTDTL, DOCINFO, CRONTASKINSTANCE, MAXUSER, MAXGROUP, MAXEXTSYSTEM, MAXAPPS, MAXTABLE, MAXVARS) and the catalog of the Maximo schema. Every query is a SELECT; nothing is created or changed.</text-property></label></cell></row><row id="540"><cell id="541"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="542"><property name="fontSize">8pt</property><property name="fontWeight">bold</property><property name="color">#161616</property><text-property name="text">Permission</text-property></label></cell>
                <cell id="543"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="544"><property name="fontSize">8pt</property><property name="color">#525252</property><text-property name="text">Runs with the Maximo database login. No DBA access is needed on any database.</text-property></label></cell></row><row id="545"><cell id="546"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="547"><property name="fontSize">8pt</property><property name="fontWeight">bold</property><property name="color">#161616</property><text-property name="text">IBM classes</text-property></label></cell>
                <cell id="548"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="549"><property name="fontSize">8pt</property><property name="color">#525252</property><text-property name="text">A Java class counts as IBM-shipped when its package starts with one of the prefixes in the IBM_Class_Prefixes parameter (default psdi. and com.ibm.). Add your business partners' prefixes there if their code moves as a product.</text-property></label></cell></row><row id="550"><cell id="551"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="552"><property name="fontSize">8pt</property><property name="fontWeight">bold</property><property name="color">#161616</property><text-property name="text">Script checks</text-property></label></cell>
                <cell id="553"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="554"><property name="fontSize">8pt</property><property name="color">#525252</property><text-property name="text">A text search in each script for the patterns in section 2. A match means "look at this script", not "it fails"; scripts without a match still need a test run.</text-property></label></cell></row><row id="555"><cell id="556"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="557"><property name="fontSize">8pt</property><property name="fontWeight">bold</property><property name="color">#161616</property><text-property name="text">Not covered</text-property></label></cell>
                <cell id="558"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="559"><property name="fontSize">8pt</property><property name="color">#525252</property><text-property name="text">Application Designer changes, start centers, workflows, report designs and data: they move with the database and need a functional test, not a rebuild. Database and operating system versions: check the MAS compatibility matrix.</text-property></label></cell></row><row id="560"><cell id="561"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="562"><property name="fontSize">8pt</property><property name="fontWeight">bold</property><property name="color">#161616</property><text-property name="text">Author</text-property></label></cell>
                <cell id="563"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="564"><property name="fontSize">8pt</property><property name="color">#525252</property><text-property name="text">Created by Mohamed Chihaoui.</text-property></label></cell></row></grid>
    </body>
